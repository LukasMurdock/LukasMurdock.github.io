---
import Head from "@/components/Head.astro";
---

<!doctype html>
<html lang="en">
  <Head
    title="Drive"
    description="A tiny open driving game by Lukas Murdock."
    urlPath="/drive/"
    noindex={true}
  />
  <body>
    <main id="driving-game" aria-label="Driving game">
      <canvas id="game-canvas" tabindex="0"></canvas>
      <canvas id="speed-lines-canvas" aria-hidden="true"></canvas>

      <header class="topbar">
        <a class="wordmark" href="/" aria-label="Return home">LM</a>
        <div class="readout" aria-live="polite">
          <span id="camera-mode">Chase</span>
        </div>
        <div class="actions">
          <button id="camera-button" type="button" title="Switch camera (C)">Camera <kbd>C</kbd></button>
          <button id="reset-button" type="button" title="Reset car (R)">Reset <kbd>R</kbd></button>
          <button id="pause-button" type="button" title="Pause game (P)">Pause <kbd>P</kbd></button>
        </div>
      </header>

      <aside id="mode-hud" class="mode-hud" aria-live="polite"></aside>

      <section id="intro" class="intro" aria-labelledby="game-title">
        <div class="intro-card">
          <p class="eyebrow">A tiny driving playground</p>
          <h1 id="game-title">Take a drive.</h1>
          <p>Follow the red-and-white circuit, link its corners, or leave the course and roam the city. There is nowhere you need to be.</p>
          <button id="start-driving" type="button">Start driving <span aria-hidden="true">→</span></button>
          <div class="key-guide" aria-label="Keyboard controls">
            <span><kbd>← →</kbd> Steer · tap twice for hard turn</span>
            <span><kbd>Space</kbd> Drift</span>
            <span><kbd>C</kbd> Camera</span>
            <span><kbd>P</kbd> Pause</span>
            <span><kbd>R</kbd> Reset</span>
          </div>
        </div>
      </section>

      <section id="pause-overlay" class="pause-overlay" aria-label="Game paused" aria-hidden="true">
        <div class="pause-card">
          <p class="eyebrow">Game paused</p>
          <h2>Take a breather.</h2>
          <button id="resume-driving" type="button">Resume driving <span aria-hidden="true">→</span></button>
        </div>
      </section>

      <div class="touch-controls" aria-label="Touch driving controls">
        <div class="steering-controls">
          <button type="button" data-control="left" aria-label="Steer left; double-tap for a hard left turn">←</button>
          <button type="button" data-control="right" aria-label="Steer right; double-tap for a hard right turn">→</button>
        </div>
        <button class="drift" type="button" data-control="handbrake" aria-label="Drift">Drift</button>
      </div>
    </main>

    <script>
      import { startDrivingGame } from "@/lib/driving-game";
      const root = document.querySelector<HTMLElement>("#driving-game");
      if (root) {
        const requestedMode = new URLSearchParams(window.location.search).get("mode");
        startDrivingGame(root, {
          mode: requestedMode === "chase" ? "chase" : "cruise",
          map: "city-circuit",
          drivingProfile: "aggressive",
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  * { box-sizing: border-box; }

  html,
  body {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    overscroll-behavior: none;
    background: #182119;
  }

  button,
  a { font: inherit; }

  button { -webkit-tap-highlight-color: transparent; }

  #driving-game {
    position: relative;
    width: 100%;
    height: 100%;
    height: 100dvh;
    overflow: hidden;
    user-select: none;
    touch-action: none;
  }

  #game-canvas {
    display: block;
    width: 100%;
    height: 100%;
    outline: none;
  }

  #speed-lines-canvas {
    position: absolute;
    z-index: 2;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    #speed-lines-canvas { display: none; }
  }

  .topbar {
    position: absolute;
    z-index: 5;
    top: 0;
    left: 0;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 18px 22px;
    color: #fff;
    pointer-events: none;
  }

  .wordmark,
  .actions button,
  .readout {
    background: rgba(18, 25, 27, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
    backdrop-filter: blur(12px);
  }

  .wordmark {
    justify-self: start;
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border-radius: 50%;
    color: #fff;
    text-decoration: none;
    font-weight: 850;
    letter-spacing: -0.06em;
    pointer-events: auto;
  }

  .readout {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 42px;
    padding: 0 17px;
    border-radius: 22px;
    font-size: 12px;
    font-weight: 750;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .mode-hud {
    position: absolute;
    z-index: 5;
    top: 74px;
    right: 22px;
    pointer-events: none;
  }

  .mode-hud:empty { display: none; }

  .chase-status[hidden] { display: none; }

  .chase-status {
    display: grid;
    width: 176px;
    gap: 4px;
    padding: 13px 15px 14px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 17px;
    background: rgba(18, 25, 27, 0.72);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.14);
    backdrop-filter: blur(12px);
    color: #fff;
  }

  .chase-status__label {
    color: rgba(255, 255, 255, 0.62);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .chase-status__message {
    overflow: hidden;
    font-size: 14px;
    letter-spacing: -0.02em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .chase-status__meter {
    height: 3px;
    margin-top: 5px;
    overflow: hidden;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.14);
  }

  .chase-status__meter > span {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    background: #e2c148;
    transform: scaleX(0);
    transform-origin: left;
  }

  .chase-status[data-pressure="danger"] .chase-status__meter > span { background: #e9553f; }

  .actions {
    justify-self: end;
    display: flex;
    gap: 8px;
    pointer-events: auto;
  }

  .actions button {
    min-height: 42px;
    padding: 0 14px;
    border-radius: 22px;
    color: #fff;
    cursor: pointer;
  }

  .actions button:hover { background: rgba(18, 25, 27, 0.9); }

  kbd {
    display: inline-flex;
    min-width: 20px;
    min-height: 20px;
    align-items: center;
    justify-content: center;
    padding: 2px 5px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.09);
    color: inherit;
    font: 700 10px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .intro {
    position: absolute;
    z-index: 10;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 24px;
    background: rgba(13, 22, 17, 0.32);
    backdrop-filter: blur(7px);
    transition: opacity 300ms ease, visibility 300ms ease;
  }

  .intro.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .intro-card {
    width: min(520px, 100%);
    padding: clamp(28px, 6vw, 54px);
    border: 1px solid rgba(255, 255, 255, 0.19);
    border-radius: 28px;
    background: rgba(20, 29, 29, 0.88);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.3);
    color: #fff;
    text-align: center;
  }

  .eyebrow {
    margin: 0 0 14px;
    color: #b9d99d;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .intro h1 {
    margin: 0;
    font-size: clamp(42px, 8vw, 72px);
    line-height: 0.98;
    letter-spacing: -0.065em;
  }

  .intro-card > p:not(.eyebrow) {
    max-width: 390px;
    margin: 22px auto 26px;
    color: rgba(255, 255, 255, 0.7);
    font-size: 15px;
    line-height: 1.55;
  }

  #start-driving {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    gap: 32px;
    padding: 0 20px 0 23px;
    border: 0;
    border-radius: 27px;
    background: #e7f5d9;
    color: #172117;
    font-weight: 800;
    cursor: pointer;
    transition: transform 160ms ease, background 160ms ease;
  }

  #start-driving:hover {
    transform: translateY(-2px);
    background: #fff;
  }

  .key-guide {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 13px;
    margin-top: 30px;
    color: rgba(255, 255, 255, 0.58);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .key-guide span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .pause-overlay {
    position: absolute;
    z-index: 9;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 24px;
    visibility: hidden;
    opacity: 0;
    background: rgba(13, 22, 17, 0.32);
    backdrop-filter: blur(7px);
    transition: opacity 180ms ease, visibility 180ms ease;
    pointer-events: none;
  }

  .pause-overlay.is-visible {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
  }

  .pause-card {
    width: min(390px, 100%);
    padding: 38px;
    border: 1px solid rgba(255, 255, 255, 0.19);
    border-radius: 26px;
    background: rgba(20, 29, 29, 0.9);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.3);
    color: #fff;
    text-align: center;
  }

  .pause-card h2 {
    margin: 0 0 26px;
    font-size: clamp(30px, 7vw, 46px);
    line-height: 1;
    letter-spacing: -0.05em;
  }

  #resume-driving {
    min-height: 48px;
    padding: 0 20px;
    border: 0;
    border-radius: 24px;
    background: #e7f5d9;
    color: #172117;
    font-weight: 800;
    cursor: pointer;
  }

  .touch-controls { display: none; }

  @media (max-width: 720px), (pointer: coarse) {
    .topbar {
      grid-template-columns: 1fr auto;
      padding: max(12px, env(safe-area-inset-top)) 12px 12px;
    }

    .readout {
      position: absolute;
      top: calc(max(12px, env(safe-area-inset-top)) + 50px);
      left: 50%;
      transform: translateX(-50%);
    }

    .actions button {
      position: relative;
      display: grid;
      width: 42px;
      padding: 0;
      place-items: center;
      overflow: hidden;
      color: transparent;
    }

    .actions button kbd {
      position: absolute;
      color: #fff;
    }

    .key-guide { display: none; }

    .mode-hud {
      top: calc(max(12px, env(safe-area-inset-top)) + 98px);
      right: 12px;
    }

    .chase-status { width: 156px; }

    .touch-controls {
      position: absolute;
      z-index: 6;
      right: 0;
      bottom: 0;
      left: 0;
      display: flex;
      align-items: end;
      justify-content: space-between;
      padding: 18px max(18px, env(safe-area-inset-right)) max(20px, env(safe-area-inset-bottom)) max(18px, env(safe-area-inset-left));
      pointer-events: none;
    }

    .steering-controls {
      display: grid;
      grid-template-columns: repeat(2, 58px);
      gap: 9px;
      pointer-events: auto;
    }

    .touch-controls button {
      width: 58px;
      height: 58px;
      border: 1px solid rgba(255, 255, 255, 0.24);
      border-radius: 50%;
      background: rgba(18, 25, 27, 0.68);
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.18);
      backdrop-filter: blur(10px);
      color: #fff;
      font-size: 22px;
      font-weight: 750;
      pointer-events: auto;
    }

    .touch-controls button.is-active {
      transform: scale(0.94);
      background: rgba(231, 245, 217, 0.92);
      color: #172117;
    }

    .touch-controls .drift {
      width: 52px;
      height: 52px;
      margin-bottom: 3px;
      font-size: 9px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
  }

  @media (max-width: 440px) {
    .readout { gap: 9px; padding: 0 12px; }
    .intro-card { border-radius: 22px; }
    .steering-controls { grid-template-columns: repeat(2, 52px); }
    .touch-controls button { width: 52px; height: 52px; }
  }
</style>
