---
import Head from "@/components/Head.astro";
import { GAME_MAPS } from "@/lib/driving-game/maps";

const mapOptions = Object.values(GAME_MAPS);
---

<!doctype html>
<html lang="en">
  <Head
    title="Drive"
    description="A tiny open driving game by Lukas Murdock."
    urlPath="/drive/"
    noindex={true}
    viewportFit={true}
  />
  <body>
    <main id="driving-game" aria-label="Driving game">
      <canvas id="game-canvas" tabindex="0"></canvas>
      <canvas id="speed-lines-canvas" aria-hidden="true"></canvas>

      <header class="topbar">
        <a class="wordmark" href="/" aria-label="Return home">LM</a>
        <div class="actions">
          <button id="camera-button" type="button" title="Switch camera (C)">
            <span class="action-label">Camera</span><span class="action-mobile" aria-hidden="true">Cam</span><kbd>C</kbd>
          </button>
          <button
            id="leaderboard-button"
            type="button"
            title="Toggle leaderboard (L)"
            aria-pressed="false"
          ><span class="action-label">Leaders</span><span class="action-mobile" aria-hidden="true">Rank</span><kbd>L</kbd></button>
          <button id="reset-button" type="button" title="Reset car (R)">
            <span class="action-label">Reset</span><span class="action-mobile" aria-hidden="true">↺</span><kbd>R</kbd>
          </button>
          <button id="pause-button" type="button" title="Pause game (P)">
            <span class="action-label">Pause</span><span class="action-mobile" aria-hidden="true">Ⅱ</span><kbd>P</kbd>
          </button>
        </div>
      </header>

      <aside id="mode-hud" class="mode-hud" aria-live="polite"></aside>
      <aside
        id="drive-leaderboard"
        class="drive-leaderboard"
        aria-live="polite"
        aria-hidden="true"
      ></aside>

      <section id="intro" class="intro" aria-labelledby="game-title">
        <div class="intro-card">
          <p class="eyebrow">A tiny driving playground</p>
          <h1 id="game-title">Take a drive.</h1>
          <p>Link corners, explore the open pavement, or simply follow whatever line looks fun. There is nowhere you need to be.</p>
          <span class="selector-label">Game mode</span>
          <div class="mode-select mode-select--between" role="group" aria-label="Game mode">
            <button type="button" data-mode-option="cruise" aria-pressed="false">
              <strong>Cruise</strong>
              <span>Drive freely</span>
            </button>
            <button type="button" data-mode-option="chase" aria-pressed="false">
              <strong>Chase</strong>
              <span>Survive pursuit</span>
            </button>
          </div>
          <span class="selector-label">Map</span>
          <div class="mode-select map-select" role="group" aria-label="Map">
            {mapOptions.map((map) => (
              <button type="button" data-map-option={map.id} aria-pressed="false">
                <strong>{map.title}</strong>
                <span>{map.description}</span>
              </button>
            ))}
          </div>
          <div class="control-mode-setting" hidden>
            <span class="selector-label">Controls</span>
            <div class="mode-select mode-select--between" role="group" aria-label="Control mode">
              <button type="button" data-control-mode-option="automatic" aria-pressed="true">
                <strong>Automatic</strong>
                <span>Steering and Drift</span>
              </button>
              <button type="button" data-control-mode-option="manual" aria-pressed="false">
                <strong>Manual</strong>
                <span>Throttle and reverse</span>
              </button>
            </div>
          </div>
          <button id="start-driving" type="button">Start driving <span aria-hidden="true">→</span></button>
          <div class="key-guide" aria-label="Keyboard controls">
            <span><kbd>← →</kbd> Steer · tap twice for hard turn</span>
            <span class="manual-control-guide" hidden><kbd>↑ W</kbd> Accelerate</span>
            <span class="manual-control-guide" hidden><kbd>↓ S</kbd> Brake · reverse</span>
            <span><kbd>Space</kbd> Drift</span>
            <span><kbd>C</kbd> Camera</span>
            <span><kbd>L</kbd> Leaders</span>
            <span><kbd>P</kbd> Pause</span>
            <span><kbd>R</kbd> Reset</span>
          </div>
        </div>
      </section>

      <section id="pause-overlay" class="pause-overlay" aria-label="Game paused" aria-hidden="true">
        <div class="pause-card">
          <p class="eyebrow">Game paused</p>
          <h2>Take a breather.</h2>
          <div class="pause-drive-time">
            <span>Current drive</span>
            <strong id="pause-drive-time">0:00.00</strong>
          </div>
          <div class="pause-mode-select">
            <span>Game mode</span>
            <div class="mode-select mode-select--pause mode-select--between" role="group" aria-label="Game mode">
              <button type="button" data-mode-option="cruise" aria-pressed="false">
                <strong>Cruise</strong>
                <span>Drive freely</span>
              </button>
              <button type="button" data-mode-option="chase" aria-pressed="false">
                <strong>Chase</strong>
                <span>Survive pursuit</span>
              </button>
            </div>
            <span>Map</span>
            <div class="mode-select map-select mode-select--pause" role="group" aria-label="Map">
              {mapOptions.map((map) => (
                <button type="button" data-map-option={map.id} aria-pressed="false">
                  <strong>{map.title}</strong>
                  <span>{map.description}</span>
                </button>
              ))}
            </div>
            <div class="control-mode-setting" hidden>
              <span>Controls</span>
              <div class="mode-select mode-select--pause" role="group" aria-label="Control mode">
                <button type="button" data-control-mode-option="automatic" aria-pressed="true">
                  <strong>Automatic</strong>
                  <span>Steering and Drift</span>
                </button>
                <button type="button" data-control-mode-option="manual" aria-pressed="false">
                  <strong>Manual</strong>
                  <span>Throttle and reverse</span>
                </button>
              </div>
            </div>
          </div>
          <div class="pause-actions">
            <button id="resume-driving" type="button">Resume driving <span aria-hidden="true">→</span></button>
            <button id="fullscreen-button" type="button" hidden>Enter fullscreen</button>
          </div>
        </div>
      </section>

      <div class="touch-controls" aria-label="Touch driving controls">
        <div class="steering-controls">
          <button type="button" data-control="left" aria-label="Steer left; double-tap for a hard left turn">
            <svg class="steering-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M15 18 9 12l6-6"></path>
            </svg>
          </button>
          <button type="button" data-control="right" aria-label="Steer right; double-tap for a hard right turn">
            <svg class="steering-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="m9 18 6-6-6-6"></path>
            </svg>
          </button>
        </div>
        <button class="drift" type="button" data-control="handbrake" aria-label="Drift"></button>
      </div>
    </main>

    <script>
      import {
        DEFAULT_GAME_MAP_ID,
        isGameMapId,
        startDrivingGame,
      } from "@/lib/driving-game";
      const root = document.querySelector<HTMLElement>("#driving-game");
      if (root) {
        const searchParams = new URLSearchParams(window.location.search);
        const selectedMode = searchParams.get("mode") === "chase" ? "chase" : "cruise";
        const requestedMap = searchParams.get("map");
        const selectedMap = isGameMapId(requestedMap) ? requestedMap : DEFAULT_GAME_MAP_ID;
        startDrivingGame(root, {
          mode: selectedMode,
          map: selectedMap,
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  * { box-sizing: border-box; }

  html,
  body {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    overscroll-behavior: none;
    background: #182119;
  }

  button,
  a { font: inherit; }

  button { -webkit-tap-highlight-color: transparent; }

  #driving-game {
    position: relative;
    width: 100%;
    height: 100%;
    height: 100dvh;
    overflow: hidden;
    -webkit-user-select: none;
    user-select: none;
  }

  #game-canvas {
    display: block;
    width: 100%;
    height: 100%;
    outline: none;
    touch-action: none;
  }

  #speed-lines-canvas {
    position: absolute;
    z-index: 2;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    #speed-lines-canvas { display: none; }
    .drive-leaderboard { transition: none !important; }
  }

  .topbar {
    position: absolute;
    z-index: 5;
    top: 0;
    left: 0;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    padding: 18px 22px;
    color: #fff;
    pointer-events: none;
  }

  .wordmark,
  .actions button {
    background: rgba(18, 25, 27, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
    backdrop-filter: blur(12px);
  }

  .wordmark {
    justify-self: start;
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border-radius: 50%;
    color: #fff;
    text-decoration: none;
    font-weight: 850;
    letter-spacing: -0.06em;
    pointer-events: auto;
  }

  .mode-hud {
    position: absolute;
    z-index: 5;
    top: 74px;
    right: 22px;
    pointer-events: none;
  }

  .mode-hud:empty { display: none; }

  .drive-leaderboard {
    position: absolute;
    z-index: 8;
    top: 74px;
    right: 22px;
    width: 176px;
    padding: 16px 18px 17px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 18px;
    opacity: 0;
    background: rgba(18, 25, 27, 0.86);
    box-shadow: 0 18px 46px rgba(0, 0, 0, 0.24);
    backdrop-filter: blur(12px);
    color: #fff;
    transform: translateY(-8px) scale(0.98);
    transition: opacity 180ms ease, transform 180ms ease;
    pointer-events: none;
  }

  #driving-game[data-game-mode="chase"] .drive-leaderboard { top: 186px; }

  .drive-leaderboard.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .drive-leaderboard.is-leaving {
    opacity: 0;
    transform: translateY(-5px) scale(0.99);
    transition-duration: 420ms;
  }

  .drive-leaderboard__title {
    display: block;
    margin-bottom: 9px;
    color: rgba(255, 255, 255, 0.62);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .drive-leaderboard__empty {
    margin: 0;
    color: rgba(255, 255, 255, 0.58);
    font-size: 11px;
  }

  .drive-leaderboard__list {
    display: grid;
    gap: 3px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .drive-leaderboard__list li {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    padding: 4px 7px;
    border-radius: 7px;
    color: rgba(255, 255, 255, 0.62);
    font-size: 10px;
    font-variant-numeric: tabular-nums;
  }

  .drive-leaderboard__list li > strong {
    color: #fff;
    font-size: 13px;
    letter-spacing: -0.02em;
  }

  .drive-leaderboard__list li.is-current {
    background: rgba(185, 217, 157, 0.13);
    color: #b9d99d;
  }

  .chase-status[hidden] { display: none; }

  .chase-status {
    display: grid;
    width: 176px;
    gap: 4px;
    padding: 13px 15px 14px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 17px;
    background: rgba(18, 25, 27, 0.72);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.14);
    backdrop-filter: blur(12px);
    color: #fff;
  }

  .chase-status__label {
    color: rgba(255, 255, 255, 0.62);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .chase-status__timer {
    font-size: 25px;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .chase-status__message {
    overflow: hidden;
    color: rgba(255, 255, 255, 0.82);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .chase-status__meter {
    height: 3px;
    margin-top: 5px;
    overflow: hidden;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.14);
  }

  .chase-status__meter > span {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    background: #e2c148;
    transform: scaleX(0);
    transform-origin: left;
  }

  .chase-status[data-pressure="danger"] .chase-status__meter > span { background: #e9553f; }

  .chase-status[data-state="captured"] {
    border-color: rgba(233, 85, 63, 0.5);
    background: rgba(47, 24, 22, 0.82);
  }

  .actions {
    justify-self: end;
    display: flex;
    gap: 8px;
    pointer-events: auto;
  }

  .actions button {
    min-height: 42px;
    padding: 0 14px;
    border-radius: 22px;
    color: #fff;
    cursor: pointer;
  }

  .actions button:hover { background: rgba(18, 25, 27, 0.9); }

  .action-mobile { display: none; }

  button:focus-visible,
  a:focus-visible {
    outline: 2px solid #e7f5d9;
    outline-offset: 3px;
  }

  kbd {
    display: inline-flex;
    min-width: 20px;
    min-height: 20px;
    align-items: center;
    justify-content: center;
    padding: 2px 5px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.09);
    color: inherit;
    font: 700 10px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .intro {
    position: absolute;
    z-index: 10;
    inset: 0;
    display: grid;
    place-items: center;
    padding:
      max(24px, env(safe-area-inset-top))
      max(24px, env(safe-area-inset-right))
      max(24px, env(safe-area-inset-bottom))
      max(24px, env(safe-area-inset-left));
    overflow-y: auto;
    background: rgba(13, 22, 17, 0.32);
    backdrop-filter: blur(7px);
    transition: opacity 300ms ease, visibility 300ms ease;
    touch-action: pan-y pinch-zoom;
  }

  .intro.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .intro-card {
    width: min(520px, 100%);
    padding: clamp(28px, 6vw, 54px);
    border: 1px solid rgba(255, 255, 255, 0.19);
    border-radius: 28px;
    background: rgba(20, 29, 29, 0.88);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.3);
    color: #fff;
    text-align: center;
  }

  .eyebrow {
    margin: 0 0 14px;
    color: #b9d99d;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .intro h1 {
    margin: 0;
    font-size: clamp(42px, 8vw, 72px);
    line-height: 0.98;
    letter-spacing: -0.065em;
  }

  .intro-card > p:not(.eyebrow) {
    max-width: 390px;
    margin: 22px auto 18px;
    color: rgba(255, 255, 255, 0.7);
    font-size: 15px;
    line-height: 1.55;
  }

  .selector-label {
    display: block;
    margin-bottom: 8px;
    color: rgba(255, 255, 255, 0.58);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-align: left;
    text-transform: uppercase;
  }

  .mode-select {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    margin: 0 auto 22px;
  }

  .map-select {
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  }

  .mode-select button {
    display: grid;
    gap: 3px;
    padding: 12px 14px;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.045);
    color: rgba(255, 255, 255, 0.66);
    font: inherit;
    text-align: left;
    transition: border-color 140ms ease, background 140ms ease, color 140ms ease;
    cursor: pointer;
  }

  .mode-select button:hover {
    border-color: rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }

  .mode-select button[aria-pressed="true"] {
    border-color: rgba(185, 217, 157, 0.72);
    background: rgba(185, 217, 157, 0.13);
    color: #fff;
  }

  .mode-select strong { font-size: 13px; }

  .mode-select span {
    color: rgba(255, 255, 255, 0.52);
    font-size: 10px;
  }

  #start-driving {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    gap: 32px;
    padding: 0 20px 0 23px;
    border: 0;
    border-radius: 27px;
    background: #e7f5d9;
    color: #172117;
    font-weight: 800;
    cursor: pointer;
    transition: transform 160ms ease, background 160ms ease;
  }

  #start-driving:hover {
    transform: translateY(-2px);
    background: #fff;
  }

  .key-guide {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 13px;
    margin-top: 30px;
    color: rgba(255, 255, 255, 0.58);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .key-guide span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .pause-overlay {
    position: absolute;
    z-index: 9;
    inset: 0;
    display: grid;
    place-items: center;
    padding:
      max(24px, env(safe-area-inset-top))
      max(24px, env(safe-area-inset-right))
      max(24px, env(safe-area-inset-bottom))
      max(24px, env(safe-area-inset-left));
    overflow-y: auto;
    visibility: hidden;
    opacity: 0;
    background: rgba(13, 22, 17, 0.32);
    backdrop-filter: blur(7px);
    transition: opacity 180ms ease, visibility 180ms ease;
    pointer-events: none;
    touch-action: pan-y pinch-zoom;
  }

  .pause-overlay.is-visible {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
  }

  .pause-card {
    width: min(390px, 100%);
    padding: 38px;
    border: 1px solid rgba(255, 255, 255, 0.19);
    border-radius: 26px;
    background: rgba(20, 29, 29, 0.9);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.3);
    color: #fff;
    text-align: center;
  }

  .pause-card h2 {
    margin: 0 0 26px;
    font-size: clamp(30px, 7vw, 46px);
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .pause-drive-time {
    display: grid;
    gap: 3px;
    margin: -8px 0 22px;
  }

  .pause-drive-time span {
    color: rgba(255, 255, 255, 0.58);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .pause-drive-time strong {
    font-size: 27px;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.05em;
  }

  .pause-mode-select > span,
  .pause-mode-select > .control-mode-setting > span {
    display: block;
    margin-bottom: 8px;
    color: rgba(255, 255, 255, 0.58);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-align: left;
    text-transform: uppercase;
  }

  .mode-select--pause { margin-bottom: 22px; }
  .mode-select--between { margin-bottom: 14px; }
  .control-mode-setting[hidden],
  #driving-game[data-desktop-controls="false"] .control-mode-setting { display: none; }

  .pause-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 9px;
  }

  #resume-driving,
  #fullscreen-button {
    min-height: 48px;
    padding: 0 20px;
    border: 0;
    border-radius: 24px;
    background: #e7f5d9;
    color: #172117;
    font-weight: 800;
    cursor: pointer;
  }

  .touch-controls {
    display: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
    touch-action: none;
  }

  .touch-controls button {
    -webkit-appearance: none;
    appearance: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
    touch-action: none;
  }

  .steering-icon {
    display: block;
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.7;
    stroke-linecap: round;
    stroke-linejoin: round;
    pointer-events: none;
  }

  #driving-game[data-touch-capable="true"] .touch-controls { display: flex; }

  @media (max-width: 720px), (any-pointer: coarse) {
    .topbar {
      grid-template-columns: 1fr auto;
      padding:
        max(12px, env(safe-area-inset-top))
        max(12px, env(safe-area-inset-right))
        12px
        max(12px, env(safe-area-inset-left));
    }

    .actions button {
      position: relative;
      display: grid;
      width: 42px;
      padding: 0;
      place-items: center;
      overflow: hidden;
    }

    .actions .action-label,
    .actions button kbd { display: none; }

    .actions .action-mobile {
      display: inline;
      color: #fff;
      font-size: 11px;
      font-weight: 800;
    }

    #reset-button .action-mobile,
    #pause-button .action-mobile { font-size: 18px; }

    .key-guide { display: none; }

    .mode-hud {
      top: calc(max(12px, env(safe-area-inset-top)) + 56px);
      right: max(12px, env(safe-area-inset-right));
    }

    .drive-leaderboard {
      top: calc(max(12px, env(safe-area-inset-top)) + 56px);
      right: max(12px, env(safe-area-inset-right));
      width: 156px;
    }

    #driving-game[data-game-mode="chase"] .drive-leaderboard {
      top: calc(max(12px, env(safe-area-inset-top)) + 166px);
    }

    .chase-status { width: 156px; }

    .touch-controls {
      position: absolute;
      z-index: 6;
      right: 0;
      bottom: 0;
      left: 0;
      align-items: end;
